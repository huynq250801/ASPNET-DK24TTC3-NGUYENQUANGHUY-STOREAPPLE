@model WebAppleStore.Models.Order
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Đặt hàng thành công";
}

<main class="main-content" style="padding: 30px 0; background: #f5f5f7;">
    <div style="max-width: 850px; margin: auto; background: #fff; padding: 30px 35px;
                border-radius: 14px; box-shadow: 0 4px 16px rgba(0,0,0,0.06);
                border: 1px solid #ededed;">

        <!-- Tiêu đề -->
        <div style="text-align:center; margin-bottom: 25px;">
            <div style="font-size:60px; color:#28a745;">✔</div>
            <h2 style="font-weight:600; color:#28a745;">Đặt hàng thành công!</h2>
            <p style="font-size:17px; margin-top:10px;">
                Mã đơn hàng:
                <strong style="color:#005bd1; font-size:20px;">@Model.OrderCode</strong>
            </p>
        </div>

        <!-- Thông tin đơn hàng -->
        <h4 style="font-weight:600; margin-bottom:10px;">Thông tin đơn hàng</h4>
        <div style="padding: 15px 20px; background:#fafafa; border-radius:10px; border:1px solid #eee; margin-bottom:25px;">
            <p><strong>Khách hàng:</strong> @Model.CustomerName</p>
            <p><strong>Số điện thoại:</strong> @Model.Phone</p>
            <p><strong>Địa chỉ:</strong> @Model.Address</p>
            <p><strong>Thời gian:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
            <p>
                <strong>Tổng tiền:</strong>
                <span style="font-size:18px; font-weight:600; color:#d40000;">
                    @Model.TotalAmount.ToString("N0")₫
                </span>
            </p>
        </div>

        <!-- Bảng sản phẩm -->
        <h4 style="font-weight:600; margin-bottom:10px;">Danh sách sản phẩm</h4>

        <table class="table" style="font-size:15px;">
            <thead style="background:#f1f1f1;">
                <tr>
                    <th style="padding:10px;">Ảnh</th>
                    <th style="padding:10px;">Sản phẩm</th>
                    <th style="padding:10px; text-align:center;">SL</th>
                    <th style="padding:10px;">Đơn giá</th>
                    <th style="padding:10px;">Tạm tính</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.OrderItems)
                {
                    <tr>
                        <!-- Ảnh -->
                        <td style="padding:10px;">
                            <img src="@item.Product?.ImageUrl"
                                 style="width:60px; height:auto; border-radius:8px; border:1px solid #e6e6e6;" />
                        </td>

                        <!-- Tên -->
                        <td style="padding:10px; font-weight:500;">
                            @item.Product?.Name
                        </td>

                        <!-- Số lượng -->
                        <td style="padding:10px; text-align:center;">
                            @item.Quantity
                        </td>

                        <!-- Giá -->
                        <td style="padding:10px;">
                            @item.UnitPrice.ToString("N0")₫
                        </td>

                        <!-- Tạm tính -->
                        <td style="padding:10px;">
                            @item.Subtotal.ToString("N0")₫
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <!-- Nút Home -->
        <div style="text-align:center; margin-top:30px;">
            <a href="/" style="
                display:inline-block;
                padding:10px 28px;
                font-size:16px;
                background:#0071e3;
                color:#fff;
                border-radius:8px;
                text-decoration:none;
                font-weight:500;">
                Về trang chủ
            </a>
        </div>

    </div>
</main>
