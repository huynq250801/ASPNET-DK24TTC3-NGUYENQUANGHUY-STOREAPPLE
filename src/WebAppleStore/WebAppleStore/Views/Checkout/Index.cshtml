@model WebAppleStore.Models.CheckoutViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Thanh toán";
    var p = Model.Product;
    var total = p != null ? p.Price * Model.Quantity : 0;
}

<div class="checkout-wrapper">

    <!-- SẢN PHẨM -->
    @if (p != null)
    {
        <div class="checkout-box">
            <div class="item-row">
                <img src="@p.ImageUrl" class="item-img" />
                <div class="item-info">
                    <h3>@p.Name</h3>
                    <div class="item-price">@p.Price.ToString("N0") ₫</div>

                    <div class="qty">
                        <button type="button" onclick="qty(-1)">−</button>
                        <input asp-for="Quantity" type="number" min="1" />
                        <button type="button" onclick="qty(1)">+</button>
                    </div>
                </div>
            </div>

            <div class="item-total">
                <span>Tạm tính:</span>
                <strong>@total.ToString("N0") ₫</strong>
            </div>
        </div>
    }

    <!-- FORM CHECKOUT -->
    <form asp-action="Index" method="post" class="checkout-box">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ProductId" />

        <h4>Thông tin khách hàng</h4>

        <label>Họ và tên</label>
        <input asp-for="CustomerName" class="input" />

        <label>Số điện thoại</label>
        <input asp-for="Phone" class="input" />

        <label>Địa chỉ</label>
        <input asp-for="Address" class="input" />

        <label>Ghi chú</label>
        <textarea asp-for="Note" class="input"></textarea>

        <hr />

        <div class="total-row">
            <span>Tổng tiền:</span>
            <strong>@total.ToString("N0") ₫</strong>
        </div>

        <button type="submit" class="btn-order">Đặt hàng</button>
    </form>
</div>

@section Styles {
    <style>
        .checkout-wrapper {
            max-width: 650px;
            margin: 20px auto;
            padding: 10px;
        }

        .checkout-box {
            background: #fff;
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 16px;
            border: 1px solid #eee;
        }

        .item-row {
            display: flex;
            gap: 12px;
            align-items: center;
        }

        .item-img {
            width: 80px;
            height: auto;
            border-radius: 6px;
        }

        .item-info h3 {
            font-size: 16px;
            margin: 0 0 4px 0;
        }

        .item-price {
            font-weight: 600;
            margin-bottom: 6px;
        }

        .qty {
            display: inline-flex;
            align-items: center;
        }

            .qty button {
                width: 28px;
                height: 28px;
                border: 1px solid #ddd;
                background: #f8f8f8;
                cursor: pointer;
            }

            .qty input {
                width: 46px;
                text-align: center;
                border: 1px solid #ddd;
                margin: 0 4px;
                height: 28px;
            }

        .item-total, .total-row {
            display: flex;
            justify-content: space-between;
            margin-top: 12px;
            font-size: 15px;
        }

        .input {
            width: 100%;
            margin-bottom: 10px;
            padding: 8px 10px;
            border: 1px solid #ddd;
            border-radius: 6px;
        }

        .btn-order {
            width: 100%;
            padding: 10px;
            background: #0071e3;
            border: none;
            color: #fff;
            font-size: 15px;
            border-radius: 6px;
            cursor: pointer;
        }

            .btn-order:hover {
                background: #005bb5;
            }
    </style>
}

@section Scripts {
    <script>
        function qty(n) {
            let input = document.querySelector("input[name='Quantity']");
            let v = parseInt(input.value || 1);
            v = v + n;
            if (v < 1) v = 1;
            input.value = v;
        }
    </script>
}
