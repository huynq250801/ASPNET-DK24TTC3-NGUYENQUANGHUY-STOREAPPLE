@model WebAppleStore.Models.HomeViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main class="main-content">
    <section class="hero-slider">
        <div class="slider-container">
            <div class="slide active">
                <img src="/imgs/banner.png" alt="Banner 1">
            </div>
            <div class="slide">
                <img src="/imgs/banner2.png" alt="Banner 2">
            </div>
            <div class="slide">
                <img src="/imgs/banner3.png" alt="Banner 3">
            </div>

            <!-- Nút điều hướng -->
            <button class="slider-btn prev">❮</button>
            <button class="slider-btn next">❯</button>

            <!-- Dots -->
            <div class="slider-dots"></div>
        </div>
    </section>


    <!-- ========================= -->
    <!-- IPHONE -->
    <!-- ========================= -->
    <h2>IPHONE</h2>
    <div class="product-grid">
        @if (Model.Iphones != null)
        {
            foreach (var p in Model.Iphones)
            {
                <div class="product-card">
                    <div class="product-image">
                        <img src="@p.ImageUrl" alt="@p.Name">
                    </div>
                    <div class="product-info">
                        <h3 class="product-title">@p.Name</h3>
                        <p class="product-price">@p.Price.ToString("N0")₫</p>
                        @if (p.OldPrice.HasValue)
                        {
                            <p class="product-price-old">@p.OldPrice.Value.ToString("N0")₫</p>
                        }
                    </div>
                    <div class="product-actions">
                        <button class="btn-buy">Mua ngay</button>
                    </div>
                </div>
            }
        }
    </div>

